setwd("~/Code/React/hello-vite-three/src")
library(tidyverse)
load("~/Code/React/hello-vite-three/src/dataverse_shareable_presidential_county_returns_1868_2020.Rdata")
View(pres_elections_release)
library(readr)
JustWinningParty <- read_csv("JustWinningParty.csv")
View(JustWinningParty)
library(readr)
data <- read_csv("~/Code/React/hello-vite-three/public/data.csv")
View(data)
colnames(pre)
colnames(pres_elections_release)
View(data)
View(pres_elections_release)
data <- pres_elections_release |>
transmute(election_year,fips,county_name,state,
democratic_raw_votes,republican_raw_votes,
winningParty=if_else(
democratic_raw_votes >republican_raw_votes,
"Demoncratic",
"Republican"
),
voteDiff = abs(
democratic_raw_votes-republican_raw_votes
)
) |>
filter(election_year > 1999)
View(data)
setwd("~/Code/React/hello-vite-three/public")
write_csv(data,'./princetonData.csv')
